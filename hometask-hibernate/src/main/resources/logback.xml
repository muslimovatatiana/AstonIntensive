<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="org.hibernate.SQL" level="DEBUG" />

    <logger name="org.hibernate.stat" level="DEBUG" />

    <logger name="org.hibernate.orm.results.loading" level="DEBUG" />

    <logger name="org.hibernate.orm.descriptor.sql" level="TRACE" />

    <logger name="ru.aston.hometask2.dao.impl.UserDaoImpl" level="OFF"/>
</configuration>
