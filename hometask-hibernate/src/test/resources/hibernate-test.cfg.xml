<hibernate-configuration>
    <session-factory>
        <property name="connection.driver_class">org.testcontainers.jdbc.ContainerDatabaseDriver</property>

        <property name="connection.url">jdbc:tc:postgresql:16://test_user_service_db</property>
        <property name="connection.username">test_postgres</property>
        <property name="connection.password">test_postgres</property>

        <property name="show_sql">false</property>
        <property name="format_sql">true</property>
        <property name="use_sql_comments">false</property>
        <property name="hibernate.current_session_context_class">thread</property>
        <property name="hibernate.default_schema">public</property>

        <property name="hbm2ddl.auto">create-drop</property>

        <mapping class="ru.aston.hometask2.models.User"/>
    </session-factory>
</hibernate-configuration>
